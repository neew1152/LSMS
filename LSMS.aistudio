      }, {
        "text": "    books \u003d conn.execute(\u0027SELECT * FROM books ORDER BY title, book_id\u0027).fetchall()\n    \n    users \u003d conn"
      }, {
        "text": ".execute(\u0027SELECT * FROM users ORDER BY role, name\u0027).fetchall()\n    \n    conn.close()\n"
      }, {
        "text": "    \n    return render_template(\u0027teacher.html\u0027, name\u003dsession[\u0027user_name\u0027], \n                           logs"
      }, {
        "text": "\u003dlogs, books\u003dbooks, users\u003dusers, \n                           selected_date\u003dselected_date, current_"
