      }, {
        "text": " user.id }}\u003c/td\u003e\n                \u003ctd\u003e{{ user.name }}\u003c/td\u003e\n                \u003ctd style\u003d\"text-transform:"
      }, {
        "text": " capitalize;\"\u003e{{ user.role }}\u003c/td\u003e\n                \u003ctd\u003e{{ user.pin }}\u003c/td\u003e\n                \u003ctd\u003e\n                    {% if"
