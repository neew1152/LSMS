        "text": " role, pin) VALUES (\u0027T01\u0027, \u0027Mrs. Smith\u0027, \u0027teacher\u0027, \u00270000\u0027)"
      }, {
        "text": "\")\n    # Test Book: ID \u0027B01\u0027\n    cursor.execute(\"INSERT INTO books (book"
      }, {
        "text": "_id, title, status) VALUES (\u0027B01\u0027, \u0027The Little Prince\u0027, \u0027Available\u0027)\")\n    print"
      }, {
        "text": "(\"Database created and test data added!\")\nexcept sqlite3.IntegrityError:\n    print(\"Database already exists with"
      }, {
        "text": " test data.\")\n\nconn.commit()\nconn.close()\n```\n*Run this file once by typing `python init"
      }, {
        "text": "_db.py` in your terminal. You will see a new file called `library.db` appear!*\n\n---\n\n### Step"
      }, {
        "text": " 3: The Web Server (`app.py`)\nThis is the \"brain\" of your app. It handles the web pages"
      }, {
        "text": " and connects to the database. \n\nCreate a file named `app.py` and paste this code:\n\n```python"
      }, {
        "text": "\nfrom flask import Flask, render_template, request, redirect, url_for, session, flash\nimport sqlite3\n\n"
      }, {
        "text": "app \u003d Flask(__name__)\napp.secret_key \u003d \u0027mother_school_secret_key\u0027 # Needed"
      }, {
        "text": " for secure logins\n\n# Helper function to connect to the database\ndef get_db_connection():\n    conn \u003d sqlite3.connect(\u0027"
      }, {
        "text": "library.db\u0027)\n    conn.row_factory \u003d sqlite3.Row # Lets us access columns by name\n    return conn"
      }, {
        "text": "\n\n# Route: Login Page\n@app.route(\u0027/\u0027, methods\u003d[\u0027GET\u0027, \u0027POST\u0027])\ndef login():\n    if request."
      }, {
        "text": "method \u003d\u003d \u0027POST\u0027:\n        user_id \u003d request.form[\u0027user_id\u0027].strip().upper()\n        pin"
      }, {
        "text": " \u003d request.form[\u0027pin\u0027].strip()\n        \n        conn \u003d get_db_connection()\n        user"
      }, {
        "text": " \u003d conn.execute(\u0027SELECT * FROM users WHERE id \u003d ? AND pin \u003d ?\u0027, (user_id, pin"
      }, {
        "text": ")).fetchone()\n        conn.close()\n\n        if user:\n            # Save user info in the session\n            session[\u0027user_"
      }, {
        "text": "id\u0027] \u003d user[\u0027id\u0027]\n            session[\u0027user_name\u0027] \u003d user[\u0027name\u0027]\n            session[\u0027"
      }, {
        "text": "role\u0027] \u003d user[\u0027role\u0027]\n            \n            # Send them to the right dashboard\n            if user[\u0027role"
      }, {
        "text": "\u0027] \u003d\u003d \u0027student\u0027:\n                return redirect(url_for(\u0027student_dashboard\u0027))\n            else:\n                return redirect("
      }, {
        "text": "url_for(\u0027teacher_dashboard\u0027))\n        else:\n            flash(\"Invalid ID or PIN. Please try again.\")\n"
      }, {
        "text": "            \n    return render_template(\u0027login.html\u0027)\n\n# Placeholder for Student Dashboard\n@app.route(\u0027/student\u0027)"
      }, {
        "text": "\ndef student_dashboard():\n    if \u0027user_id\u0027 not in session or session[\u0027role\u0027] !\u003d \u0027"
      }, {
        "text": "student\u0027:\n        return redirect(url_for(\u0027login\u0027))\n    return f\"Welcome Student: {session[\u0027user_name"
      }, {
        "text": "\u0027]}! (Dashboard coming next)\"\n\n# Placeholder for Teacher Dashboard\n@app.route(\u0027/teacher\u0027)\ndef teacher"
      }, {
        "text": "_dashboard():\n    if \u0027user_id\u0027 not in session or session[\u0027role\u0027] !\u003d \u0027teacher\u0027:\n"
      }, {
        "text": "        return redirect(url_for(\u0027login\u0027))\n    return f\"Welcome Teacher: {session[\u0027user_name"
      }, {
        "text": "\u0027]}! (Dashboard coming next)\"\n\n# Route: Logout\n@app.route(\u0027/logout\u0027)\ndef logout():"
      }, {
        "text": "\n    session.clear()\n    return redirect(url_for(\u0027login\u0027))\n\nif __name__ \u003d\u003d \u0027__"
      }, {
        "text": "main__\u0027:\n    # Runs locally on port 5000\n    app.run(debug\u003dTrue, host"
      }, {
        "text": "\u003d\u0027127.0.0.1\u0027, port\u003d5000)\n```\n\n---\n\n### Step "
      }, {
        "text": "4: The Login Page (`templates/login.html`)\nThis is what the students and teachers will see. I added a little bit"
      }, {
        "text": " of CSS to make it look clean and centered on the screen.\n\nInside your `templates` folder, create `login.html` and paste"
      }, {
        "text": " this:\n\n```html\n\u003c!DOCTYPE html\u003e\n\u003chtml lang\u003d\"en\"\u003e\n\u003chead\u003e\n    \u003c"
      }, {
        "text": "meta charset\u003d\"UTF-8\"\u003e\n    \u003cmeta name\u003d\"viewport\" content\u003d\"width\u003ddevice-width, initial-scale\u003d1."
      }, {
        "text": "0\"\u003e\n    \u003ctitle\u003eLSMS - Login\u003c/title\u003e\n    \u003cstyle\u003e\n        body { font-family: Arial"
      }, {
        "text": ", sans-serif; background-color: #f4f7f6; display: flex; justify-content: center; align"
      }, {
        "text": "-items: center; height: 100vh; margin: 0; }\n        .login-"
      }, {
        "text": "box { background: white; padding: 30px; border-radius: 10px; box-shadow"
      }, {
        "text": ": 0 4px 8px rgba(0,0,0,0.1); width: 30"
      }, {
        "text": "0px; text-align: center; }\n        h2 { color: #333; }\n        input {"
      }, {
        "text": " width: 90%; padding: 10px; margin: 10px 0; border: 1px solid"
      }, {
        "text": " #ccc; border-radius: 5px; font-size: 16px; }\n        button"
      }, {
        "text": " { width: 100%; padding: 10px; background-color: #4CAF50; color:"
      }, {
        "text": " white; border: none; border-radius: 5px; font-size: 16px; cursor"
      }, {
        "text": ": pointer; }\n        button:hover { background-color: #45a049; }\n"
      }, {
        "text": "        .error { color: red; margin-bottom: 10px; }\n    \u003c/style\u003e\n"
      }, {
        "text": "\u003c/head\u003e\n\u003cbody\u003e\n\n    \u003cdiv class\u003d\"login-box\"\u003e\n        \u003ch2\u003e📚 Library Login\u003c/h2\u003e\n        \n"
      }, {
        "text": "        \u003c!-- Display Error Messages --\u003e\n        {% with messages \u003d get_flashed_messages() %}\n            {% if messages %}\n                "
      }, {
        "text": "\u003cdiv class\u003d\"error\"\u003e{{ messages[0] }}\u003c/div\u003e\n            {% endif %}\n        {% endwith %}\n\n        \u003cform action\u003d\"/\""
      }, {
        "text": " method\u003d\"POST\"\u003e\n            \u003cinput type\u003d\"text\" name\u003d\"user_id\" placeholder\u003d\"Enter ID (e"
      }, {
        "text": ".g. S01)\" required autocomplete\u003d\"off\"\u003e\n            \u003cinput type\u003d\"password\" name\u003d\"pin\" placeholder\u003d\"Enter"
      }, {
        "text": " PIN\" required\u003e\n            \u003cbutton type\u003d\"submit\"\u003eLogin\u003c/button\u003e\n        \u003c/form\u003e\n    \u003c/div\u003e\n\n\u003c/body\u003e\n\u003c/html\u003e"
      }, {
        "text": "\n```\n\n---\n\n### How to test it right now:\n1. Open your terminal in the `LSMS` folder.\n"
      }, {
        "text": "2. Run the database script: `python init_db.py`\n3. Start the server: `python app"
      }, {
        "text": ".py`\n4. Open your web browser and go to: `http://127.0.0.1:"
      }, {
        "text": "5000`\n5. Try logging in as the student (`ID: S01`, `PIN: 12"
      }, {
        "text": "34`) or the teacher (`ID: T01`, `PIN: 0000`).\n\nTry"
      }, {
        "text": " this out! If it works and you can log in, **let me know**, and our next step will be building"
      }, {
        "text": " the **Student Dashboard (Borrowing/Returning) with the 10-minute auto-logout feature**."
