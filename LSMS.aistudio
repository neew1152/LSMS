      }, {
        "text": "\n@app.route(\u0027/add_book\u0027, methods\u003d[\u0027POST\u0027])\ndef add_book():\n    book_"
      }, {
        "text": "id \u003d request.form[\u0027book_id\u0027].strip().upper()\n    title \u003d request.form[\u0027title\u0027]."
